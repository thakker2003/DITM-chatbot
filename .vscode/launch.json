{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DITM Chatbot",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/bin/python",
      "jinja": true
    },
    {
      "name": "Rebuild Index (ingest.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ingest.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/venv/bin/python",
      "console": "integratedTerminal"
    }
  ]
}
